{
  "name": "honeybee",
  "version": "0.0.1",
  "description": "On-demand tmux cockpit for interactive AI bees; CLI: hive.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./comb": {
      "types": "./dist/comb/sdk.d.ts",
      "default": "./dist/comb/sdk.js"
    },
    "./execution/v1": {
      "types": "./dist/execution/index.d.ts",
      "default": "./dist/execution/index.js"
    }
  },
  "bin": {
    "hive": "dist/cli.js",
    "hive-x": "dist/cli-x.js",
    "ap": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "chmod +x dist/cli.js dist/cli-x.js",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "execution:digest": "tsx scripts/update-execution-digest.mjs",
    "dev": "tsx src/cli.ts",
    "hive": "node dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "25.7.0",
    "tsx": "4.21.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "uuid": "^14.0.1"
  }
}
