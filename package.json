{
  "name": "honeybee",
  "version": "0.0.1",
  "description": "On-demand tmux cockpit for interactive AI bees; CLI: hive.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./comb": {
      "types": "./dist/comb/sdk.d.ts",
      "default": "./dist/comb/sdk.js"
    },
    "./execution/v1": {
      "types": "./dist/execution/index.d.ts",
      "default": "./dist/execution/index.js"
    }
  },
  "files": [
    "dist/",
    "contracts/",
    "docs/honeybee.tmux.conf"
  ],
  "bin": {
    "hive": "dist/cli.js",
    "hive-x": "dist/cli-x.js",
    "ap": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-runner-host-artifact.mjs",
    "build:test": "node scripts/build-tests.mjs",
    "postbuild": "chmod +x dist/cli.js dist/cli-x.js",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "v2:check": "tsc -p v2/core/tsconfig.json && tsc -p v2/harness/tsconfig.json && tsc -p v2/adapters/tsconfig.json && tsc -p v2/driver-hsr/tsconfig.json",
    "v2:test": "node --test \"v2/core/tests/*.test.ts\"",
    "v2:harness": "node --test \"v2/harness/tests/*.test.ts\"",
    "v2:harness:long": "HARNESS_PROFILE=long node --test \"v2/harness/tests/*.test.ts\"",
    "v2:driver": "node --test \"v2/adapters/tests/*.test.ts\" \"v2/driver-hsr/tests/*.test.ts\"",
    "v2:harness:real": "node --test \"v2/driver-hsr/tests/harness/*.test.ts\"",
    "deploy": "node scripts/deploy-settle.mjs",
    "pretest": "npm run build:test",
    "test": "node scripts/run-tests.mjs",
    "test:source": "node --import tsx --test --test-concurrency=8 --test-reporter=dot tests/*.test.ts",
    "execution:digest": "tsx scripts/update-execution-digest.mjs",
    "dev": "tsx src/cli.ts",
    "hive": "node dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "25.7.0",
    "esbuild": "0.27.7",
    "tsx": "4.21.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.67",
    "ajv": "^8.17.1",
    "uuid": "^14.0.1"
  }
}
