{
  "schemaVersion": 1,
  "runnerVersion": 1,
  "description": "Executable Honeybee Combs strict-spine corpus. Cases run in order against one fresh store. $type, $pattern, $optional, $required, and $contains are matcher directives; $name strings are captures or materialized fixture paths.",
  "exitCodes": {
    "success_or_durable_ack": 0,
    "invalid_argument_or_schema": 2,
    "not_found": 3,
    "version_claim_or_idempotency_conflict": 4,
    "ambiguous_activation_or_approval_required": 5,
    "unresolved_effect_ambiguity": 6,
    "external_dependency": 7,
    "internal_or_corrupt_state": 70
  },
  "fixtures": {
    "simpleComb": {
      "formatVersion": 2,
      "name": "corpus-review",
      "input": {
        "kind": "json-schema",
        "schema": {
          "type": "object",
          "properties": {
            "ref": { "type": "string" }
          },
          "required": ["ref"],
          "additionalProperties": false
        }
      },
      "nodes": [
        {
          "id": "work",
          "executor": "agent",
          "binding": "strict",
          "agent": {
            "capacity": { "kind": "spawn", "bee": "codex", "account": "auto" },
            "brief": "Review {{input.ref}}."
          },
          "output": {
            "kind": "json-schema",
            "schema": {
              "type": "object",
              "properties": {
                "verdict": { "enum": ["pass", "fail"] }
              },
              "required": ["verdict"],
              "additionalProperties": false
            }
          }
        }
      ],
      "edges": []
    },
    "claimComb": {
      "formatVersion": 2,
      "name": "corpus-claim",
      "input": {
        "kind": "json-schema",
        "schema": {
          "type": "object",
          "properties": {
            "ref": { "type": "string" }
          },
          "required": ["ref"],
          "additionalProperties": false
        }
      },
      "claim": {
        "scope": "product-comb",
        "inputPointer": "/ref",
        "collision": "join-existing"
      },
      "nodes": [
        {
          "id": "work",
          "executor": "agent",
          "binding": "strict",
          "agent": {
            "capacity": { "kind": "spawn", "bee": "codex", "account": "auto" },
            "brief": "Review {{input.ref}}."
          }
        }
      ],
      "edges": []
    },
    "terminalDoneComb": {
      "formatVersion": 2,
      "name": "corpus-terminal-done",
      "input": { "kind": "informal", "description": "fixture input" },
      "nodes": [
        {
          "id": "finish",
          "executor": "engine",
          "binding": "strict",
          "engine": {
            "kind": "predicate",
            "predicate": {
              "kind": "clock",
              "afterMs": 0,
              "from": "activation-start"
            }
          }
        }
      ],
      "edges": []
    },
    "terminalFailedComb": {
      "formatVersion": 2,
      "name": "corpus-terminal-failed",
      "input": { "kind": "informal", "description": "fixture input" },
      "nodes": [
        {
          "id": "finish",
          "executor": "engine",
          "binding": "strict",
          "engine": {
            "kind": "predicate",
            "predicate": {
              "kind": "clock",
              "afterMs": 0,
              "from": "activation-start"
            }
          }
        }
      ],
      "edges": [],
      "output": {
        "contract": {
          "kind": "json-schema",
          "schema": { "type": "string" }
        },
        "value": {
          "source": "node-output",
          "nodeId": "finish",
          "pointer": "",
          "lineage": "current",
          "item": "same"
        }
      }
    },
    "inputHead": { "ref": "HEAD" },
    "inputOther": { "ref": "OTHER" }
  },
