          "joinedExisting": false,
          "replayedDelivery": false,
          "intakeReady": false
        }
      }
    },
    {
      "id": "comb-define-claim",
      "argv": ["comb", "define", "$claimComb", "--json"],
      "exitCode": 0,
      "stdout": {
        "ok": true,
        "command": "comb.define",
        "result": {
          "comb": { "name": "corpus-claim", "version": 1 },
          "created": true
        }
      }
    },
    {
      "id": "comb-run-claim-holder",
      "argv": ["comb", "run", "corpus-claim", "--version", "1", "--input", "$inputHead", "--cwd", "$fixtureCwd", "--product", "corpus-product", "--json"],
      "exitCode": 0,
      "capture": { "holdingRunId": "/result/run/id" },
      "stdout": {
        "ok": true,
        "command": "comb.run",
        "result": {
          "run": { "id": { "$type": "string" }, "status": "active" },
          "created": true,
          "joinedExisting": false,
          "replayedDelivery": false,
          "intakeReady": false
        }
      }
    },
    {
      "id": "comb-run-join-refusal",
      "argv": ["comb", "run", "corpus-claim", "--version", "1", "--input", "$inputHead", "--cwd", "$fixtureCwd", "--product", "corpus-product", "--origin-trigger", "trigger-claim", "--origin-delivery", "delivery-claim", "--collision", "join-existing", "--json"],
      "exitCode": 4,
      "stdout": {
        "ok": false,
        "command": "comb.run",
        "error": {
          "code": "claim_conflict",
          "message": { "$pattern": "^claim conflict: held by " },
          "details": {
            "claimId": { "$pattern": "^[0-9a-f]{64}$" },
            "holdingRunId": "$holdingRunId",
            "holdingRunStatus": "active",
            "cleanupStatus": "not-required"
          }
        }
      }
    },
    {
      "id": "comb-not-found-failure",
      "argv": ["comb", "status", "missing", "--json"],
      "exitCode": 3,
      "stdout": {
        "ok": false,
        "command": "comb.status",
        "error": {
          "code": "not_found",
          "message": "comb run not found: missing"
        }
      }
    },
    {
      "id": "comb-product-required",
      "argv": ["comb", "run", "corpus-review", "--version", "1", "--input", "$inputHead", "--cwd", "$fixtureCwd", "--json"],
      "exitCode": 2,
      "stdout": {
        "ok": false,
        "command": "comb.run",
        "error": {
          "code": "invalid_argument",
          "message": "--product is required in strict-spine slice 1; product identity is never inferred from cwd"
        }
      }
    },
    {
      "id": "comb-corrupt-state",
      "arrange": [
        {
          "kind": "write-store-file",
          "path": "combs/definitions/corrupt-comb/index.json",
          "contents": "{not-json"
        }
      ],
      "argv": ["comb", "inspect", "corrupt-comb", "--json"],
      "exitCode": 70,
      "stdout": {
        "ok": false,
        "command": "comb.inspect",
        "error": {
          "code": "corrupt_state",
          "message": { "$pattern": "^(Unexpected|Expected)" }
        }
      }
    },
    {
      "id": "comb-transient-io-classification",
      "argv": ["comb", "run", "corpus-review", "--version", "1", "--input", "$inputHead", "--cwd", "$fixtureCwd", "--product", "corpus-product", "--json"],
      "fault": { "code": "EIO", "message": "fixture I/O interruption" },
      "exitCode": 7,
      "stdout": {
        "ok": false,
        "command": "comb.run",
        "error": {
          "code": "external_dependency",
          "message": "fixture I/O interruption",
          "details": { "errno": "EIO" }
        }
      }
    }
  ]
}
